# Localjoin environment template — never paste live secrets here
PYTHON_VERSION=3.13.15
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_BASE_PATH=/
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DATABASE_URL=mysql+pymysql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@db-host:3306/database?charset=utf8mb4
AUTO_INIT_SCHEMA=false
APP_REQUIRE_EMAIL_VERIFICATION=true
APP_ADMIN_MFA_REQUIRED=true
SESSION_COOKIE_SECURE=true
FORCE_HTTPS=true
TRUST_PROXY=true
TRUSTED_PROXY_IPS=*
TRUSTED_PROXY_HOPS=1
TRUSTED_HOSTS=example.onrender.com
SECURITY_CSP_MODE=enforce
APP_MAIL_DRIVER=resend
APP_MAIL_FROM=verified-sender@your-domain.example
RESEND_API_KEY=REPLACE_WITH_API_KEY
APP_SUPPORT_EMAIL=support@your-domain.example
UPLOAD_STORAGE_BACKEND=filesystem
UPLOAD_STORAGE_ROOT=/var/data/localconnect/uploads
UPLOAD_DISK_REQUIRED=true
UPLOAD_REQUIRE_REENCODE=true
MAX_REQUEST_BYTES=8388608
SLOW_REQUEST_MS=1500
PAYMENT_ALLOW_LIVE=false
# Do not enable live payment until the original payment environment is verified.
